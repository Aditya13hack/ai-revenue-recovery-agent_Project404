# =============================================================================
# AI Revenue Recovery Agent — Environment Configuration
# Copy this file to .env and fill in your API keys
# =============================================================================

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Razorpay Test Mode Keys (get from https://dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# LLM Configuration
LLM_PROVIDER=groq
LLM_MODEL=groq/compound-mini
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=llama3.1:8b

# Database
DATABASE_URL=sqlite:///./recovery_agent.db

# Campaign Configuration (₹)
CAMPAIGN_BUDGET=50000
MAX_DISCOUNT_PCT=15
MAX_CONTACT_ATTEMPTS=3
MAX_PAYMENT_RETRIES=2
MAX_EXTENSION_DAYS=7
REFUSAL_ESCALATION_THRESHOLD=2
